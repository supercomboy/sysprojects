<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Corner Radius ===== -->
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">6</CornerRadius>

    <!-- ===== Padding ===== -->
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="SectionPadding">24</Thickness>
    <Thickness x:Key="ButtonPadding">16,8</Thickness>
    <Thickness x:Key="InputPadding">10,6</Thickness>

    <!-- ===== Font Size ===== -->
    <sys:Double x:Key="FontSizeH1">32</sys:Double>
    <sys:Double x:Key="FontSizeH2">22</sys:Double>
    <sys:Double x:Key="FontSizeH3">16</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeTiny">11</sys:Double>

</ResourceDictionary>