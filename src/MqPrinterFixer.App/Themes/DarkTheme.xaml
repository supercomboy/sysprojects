<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Surfaces ===== -->
    <SolidColorBrush x:Key="AppBackgroundBrush"     Color="#202020"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"    Color="#2B2B2B"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush"  Color="#1C1C1C"/>
    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#0A0A0A"/>

    <!-- ===== Accent ===== -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#4CC2FF"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#6FD0FF"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#3B9BD1"/>

    <!-- ===== Semantic ===== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100"/>
    <SolidColorBrush x:Key="ErrorBrush"   Color="#FF99A4"/>
    <SolidColorBrush x:Key="InfoBrush"    Color="#60CDFF"/>

    <!-- ===== Text ===== -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="TextDisabledBrush"  Color="#6A6A6A"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#0A0A0A"/>

    <!-- ===== Borders & States ===== -->
    <SolidColorBrush x:Key="BorderBrush"               Color="#3A3A3A"/>
    <SolidColorBrush x:Key="DividerBrush"              Color="#2E2E2E"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush"      Color="#333333"/>
    <SolidColorBrush x:Key="SelectionBackgroundBrush"  Color="#0A3D62"/>
    <SolidColorBrush x:Key="NavigationSelectedBrush"   Color="#2D3E50"/>
    <SolidColorBrush x:Key="NavigationHoverBrush"      Color="#2E2E2E"/>

</ResourceDictionary>