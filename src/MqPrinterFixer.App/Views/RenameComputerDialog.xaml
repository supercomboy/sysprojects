<Window x:Class="MqPrinterFixer.App.Views.RenameComputerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MqPrinterFixer.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RenameComputerDialogViewModel}"
        Title="Rename Computer"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource CardBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Rename Computer" Style="{StaticResource H2TextStyle}"/>
            <TextBlock Text="Đổi tên máy tính. Cần Administrator và restart sau khi đổi."
                       Style="{StaticResource SmallTextStyle}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ===================== STAGE: INPUT ===================== -->
        <StackPanel Grid.Row="1">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Stage}" Value="Input">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="Current name" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Text="{Binding CurrentName}" Style="{StaticResource H3TextStyle}" Margin="0,0,0,16"/>

            <TextBlock Text="New name" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource AppTextBoxStyle}"/>

            <!-- Validation error - CHỈ dùng TextBlock.Style element, KHÔNG có Style attribute -->
            <TextBlock Text="{Binding ValidationError}"
                       Margin="0,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SmallTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNewNameValid}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="Chỉ cho phép chữ cái, chữ số, dấu gạch ngang. Tối đa 15 ký tự."
                       Style="{StaticResource CaptionTextStyle}"
                       Margin="0,6,0,0"/>

            <!-- Admin warning - CHỈ dùng Border.Style element -->
            <Border Margin="0,16,0,0"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="12,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAdministrator}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="App đang không chạy với quyền Administrator. Vui lòng đóng và mở lại bằng 'Run as administrator' trước khi Apply."
                           Foreground="Black"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSizeSmall}"/>
            </Border>
        </StackPanel>

        <!-- ===================== STAGE: PREVIEW ===================== -->
        <StackPanel Grid.Row="1">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Stage}" Value="Preview">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="Preview change" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Current:" Style="{StaticResource SmallTextStyle}"/>
                        <TextBlock Text="Proposed:" Style="{StaticResource SmallTextStyle}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding CurrentName}" Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock Text="{Binding NewName}"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Sau khi Apply thành công, cần khởi động lại máy để tên mới có hiệu lực."
                       Style="{StaticResource SmallTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"/>
        </StackPanel>

        <!-- ===================== STAGE: RESULT ===================== -->
        <StackPanel Grid.Row="1">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Stage}" Value="Result">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Border Style="{StaticResource CardStyle}">
                <TextBlock Text="{Binding ResultMessage}"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- ===================== BOTTOM BUTTONS ===================== -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <!-- INPUT stage buttons -->
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Input">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"/>

                <Button Content="Preview"
                        Command="{Binding GoToPreviewCommand}"
                        IsEnabled="{Binding IsNewNameValid}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>

            <!-- PREVIEW stage buttons -->
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Preview">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Button Content="Back"
                        Command="{Binding BackToInputCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"/>

                <Button Content="Apply Change"
                        Command="{Binding ApplyCommand}"
                        IsEnabled="{Binding IsAdministrator}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>

            <!-- RESULT stage buttons - dùng Button.Style element (cần DataTrigger) -->
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Result">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Restart Now -->
                <Button Content="Restart Now"
                        Command="{Binding RestartNowCommand}"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RestartRequired}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Restart Later -->
                <Button Content="Restart Later"
                        Command="{Binding RestartLaterCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RestartRequired}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Close - chỉ hiện khi result là failure -->
                <Button Content="Close"
                        Command="{Binding CancelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RestartRequired}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>