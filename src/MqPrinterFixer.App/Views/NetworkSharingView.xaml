<UserControl x:Class="MqPrinterFixer.App.Views.NetworkSharingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MqPrinterFixer.App.ViewModels"
             xmlns:models="clr-namespace:MqPrinterFixer.App.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NetworkSharingViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel Margin="24">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1TextStyle}"/>
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Rescan"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Top"/>
            </Grid>

            <!-- Active Network + Sharing Status (2 cột) -->
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Active Network" Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectionDisplay}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Adapter" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Network.AdapterName}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Network Name" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Network.NetworkName}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Category" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CategoryDisplay}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="IPv4 Address" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Network.IPv4Address}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="MAC Address" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Network.MacAddress}" Style="{StaticResource BodyTextStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Sharing Status" Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Network Discovery"
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding NetworkDiscoveryDisplay}"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="File &amp; Printer Sharing"
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding FileAndPrinterSharingDisplay}"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Password Protected Sharing"
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding PasswordProtectedSharingDisplay}"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Actions -->
            <TextBlock Text="Sharing Actions"
                       Style="{StaticResource H2TextStyle}"
                       Margin="0,24,0,12"/>

            <UniformGrid Columns="2">

                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Network Profile" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="{Binding CategoryDisplay, StringFormat='Current: {0}'}"
                                       Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Text="Chuyển Public → Private để hỗ trợ LAN discovery."
                                       Style="{StaticResource SmallTextStyle}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Configure"
                                Command="{Binding PreviewChangeCommand}"
                                CommandParameter="{x:Static models:NetworkChangeAction.ChangeNetworkToPrivate}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Network Discovery" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="{Binding NetworkDiscoveryDisplay, StringFormat='Current: {0}'}"
                                       Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Text="Bật firewall rules cho discovery trên Private profile."
                                       Style="{StaticResource SmallTextStyle}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Configure"
                                Command="{Binding PreviewChangeCommand}"
                                CommandParameter="{x:Static models:NetworkChangeAction.EnableNetworkDiscovery}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,8,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="File &amp; Printer Sharing" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="{Binding FileAndPrinterSharingDisplay, StringFormat='Current: {0}'}"
                                       Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Text="Bật firewall rules cho SMB printer sharing."
                                       Style="{StaticResource SmallTextStyle}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Configure"
                                Command="{Binding PreviewChangeCommand}"
                                CommandParameter="{x:Static models:NetworkChangeAction.EnableFileAndPrinterSharing}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Password Protected Sharing" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="{Binding PasswordProtectedSharingDisplay, StringFormat='Current: {0}'}"
                                       Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Text="Chỉ tắt trong LAN tin cậy — giảm bảo mật."
                                       Style="{StaticResource SmallTextStyle}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Configure"
                                Command="{Binding PreviewChangeCommand}"
                                CommandParameter="{x:Static models:NetworkChangeAction.TurnOffPasswordProtectedSharing}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </UniformGrid>

            <!-- Preview panel — chỉ hiển thị khi ActivePreview != null -->
            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActivePreview}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel DataContext="{Binding ActivePreview}">
                    <TextBlock Text="Preview Change" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H3TextStyle}" Margin="0,4,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Current:" Style="{StaticResource SmallTextStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentState}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Proposed:" Style="{StaticResource SmallTextStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProposedState}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                    </Grid>

                    <TextBlock Text="{Binding Reason}"
                               Style="{StaticResource SmallTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                    <!-- Warning banner khi cần confirmation -->
                    <Border Margin="0,12,0,0"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="12,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RequiresConfirmation}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="⚠ Cảnh báo bảo mật: Thao tác này làm giảm mức bảo vệ. Chỉ tiếp tục nếu bạn kiểm soát toàn bộ thiết bị trong LAN."
                                   Foreground="Black"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSizeSmall}"/>
                    </Border>

                    <!-- Block reason khi không thể apply -->
                    <Border Margin="0,12,0,0"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="12,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanApply}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding BlockReason}"
                                   Foreground="{DynamicResource TextOnPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSizeSmall}"/>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Buttons của preview (ngoài DataContext ActivePreview) -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActivePreview}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Button Content="Cancel"
                        Command="{Binding CancelPreviewCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"/>

                <Button Content="Apply Change"
                        Command="{Binding ApplyChangeCommand}"
                        IsEnabled="{Binding ActivePreview.CanApply}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>

            <!-- Apply result message -->
            <Border Margin="0,12,0,0"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="12,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ApplyResultIsSuccess}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ApplyResultMessage}" Value=""/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ApplyResultMessage}"
                           Foreground="{DynamicResource TextOnPrimaryBrush}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSizeSmall}"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>