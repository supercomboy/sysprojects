<UserControl x:Class="MqPrinterFixer.App.Views.PrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MqPrinterFixer.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PrintersViewModel}">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1TextStyle}"/>
                <TextBlock Text="{Binding Description}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,6,0,0"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Rescan"
                    Command="{Binding LoadCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Top"/>
        </Grid>

        <!-- Body: DataGrid + Details panel -->
        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Printers}"
                      SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"
                      Style="{StaticResource AppDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource AppDataGridRowStyle}"
                      CellStyle="{StaticResource AppDataGridCellStyle}"
                      Margin="0,0,16,0">
                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="&#xE749;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{DynamicResource BadgeCornerRadius}"
                                        Padding="8,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource TextDisabledBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="{DynamicResource TextOnPrimaryBrush}"
                                               FontSize="{DynamicResource FontSizeTiny}"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Default" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding ConnectionType}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Port"
                                        Binding="{Binding PortName}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Shared"
                                        Binding="{Binding IsShared}"
                                        Width="70"/>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Details panel -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Printer Details" Style="{StaticResource SectionHeaderStyle}"/>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPrinter}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Chọn một máy in để xem chi tiết."
                                       Style="{StaticResource SmallTextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel DataContext="{Binding SelectedPrinter}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding Name}"
                                       Style="{StaticResource H3TextStyle}"
                                       Margin="0,8,0,12"/>

                            <TextBlock Text="Status" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="Default" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding IsDefault}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="Driver" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding DriverName}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Port" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding PortName}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="Connection Type" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding ConnectionType}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="Shared" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding IsShared}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="Share Name" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding ShareName}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="Source Host" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding SourceHost}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="Printer Path" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding PrinterPath}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Location" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding Location}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Comment" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding Comment}" Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>