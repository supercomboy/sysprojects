<UserControl x:Class="MqPrinterFixer.App.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MqPrinterFixer.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdvancedViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel Margin="24">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1TextStyle}"/>
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Rescan"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Top"/>
            </Grid>

            <!-- ============ FIREWALL CARD ============ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,24,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Windows Firewall" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="{Binding FirewallOverallDisplay}"
                                       Style="{StaticResource H3TextStyle}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Không tắt Firewall. Chỉ bật rules cần thiết cho printer sharing."
                                       Style="{StaticResource SmallTextStyle}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Enable Required Rules"
                                Command="{Binding EnableRequiredFirewallRulesCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Firewall.Checks}" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SidebarBackgroundBrush}"
                                        CornerRadius="{DynamicResource InputCornerRadius}"
                                        Padding="12,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayName}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   Style="{StaticResource SmallTextStyle}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EnabledRules}"
                                                       Style="{StaticResource SmallTextStyle}"/>
                                            <TextBlock Text="/"
                                                       Style="{StaticResource SmallTextStyle}"
                                                       Margin="2,0"/>
                                            <TextBlock Text="{Binding TotalRules}"
                                                       Style="{StaticResource SmallTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Apply firewall result banner -->
                    <Border Margin="0,12,0,0"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="12,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasApplyResultMessage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ApplyResultIsSuccess}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ApplyResultMessage}"
                                   Foreground="{DynamicResource TextOnPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSizeSmall}"/>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ============ PRINT SPOOLER CARD ============ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Print Spooler" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="{Binding SpoolerStatusDisplay}"
                                       Style="{StaticResource H3TextStyle}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Service in ấn trung tâm của Windows. Stop/Restart có thể cần khi printer bị treo."
                                       Style="{StaticResource SmallTextStyle}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Start"
                                    Command="{Binding StartSpoolerCommand}"
                                    IsEnabled="{Binding CanStartSpooler}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"/>

                            <Button Content="Restart"
                                    Command="{Binding RestartSpoolerCommand}"
                                    IsEnabled="{Binding CanRestartSpooler}"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Spooler result banner -->
                    <Border Margin="0,12,0,0"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="12,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSpoolerResultMessage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SpoolerResultIsSuccess}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SpoolerResultMessage}"
                                   Foreground="{DynamicResource TextOnPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSizeSmall}"/>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Placeholder: Printer Ports & Policies -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Printer Ports &amp; Policies" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="Ports, Point and Print, policies — Phase 19."
                               Style="{StaticResource SmallTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Placeholder: Change History -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Change History" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="Transaction log của mọi thay đổi — Phase 20."
                               Style="{StaticResource SmallTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>