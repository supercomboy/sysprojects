<Application x:Class="MqPrinterFixer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Layout resources: không phụ thuộc theme -->
                <ResourceDictionary Source="Themes/ThemeResources.xaml"/>

                <!-- Theme mặc định khi app mới load xaml -->
                <!-- ThemeService.Initialize() sẽ swap nếu cần -->
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>