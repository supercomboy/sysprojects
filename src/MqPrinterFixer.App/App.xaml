<Application x:Class="MqPrinterFixer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MqPrinterFixer.App.ViewModels"
             xmlns:views="clr-namespace:MqPrinterFixer.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="Themes/ThemeResources.xaml"/>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>

                <ResourceDictionary Source="Styles/Typography.xaml"/>
                <ResourceDictionary Source="Styles/Buttons.xaml"/>
                <ResourceDictionary Source="Styles/Cards.xaml"/>
                <ResourceDictionary Source="Styles/Navigation.xaml"/>
                <ResourceDictionary Source="Styles/StatusBadge.xaml"/>
                <ResourceDictionary Source="Styles/TextBoxes.xaml"/>
                <ResourceDictionary Source="Styles/ComboBoxes.xaml"/>
                <ResourceDictionary Source="Styles/Toggles.xaml"/>
                <ResourceDictionary Source="Styles/DataGrid.xaml"/>
                <ResourceDictionary Source="Styles/Dialogs.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PrintersViewModel}">
                <views:PrintersView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:NetworkSharingViewModel}">
                <views:NetworkSharingView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AdvancedViewModel}">
                <views:AdvancedView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PageViewModelBase}">
                <views:PlaceholderPageView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>