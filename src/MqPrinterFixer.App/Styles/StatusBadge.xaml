<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base badge style - mọi badge kế thừa từ đây -->
    <Style x:Key="StatusBadgeBaseStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource BadgeCornerRadius}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="SuccessBadgeStyle" TargetType="Border" BasedOn="{StaticResource StatusBadgeBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
    </Style>

    <Style x:Key="WarningBadgeStyle" TargetType="Border" BasedOn="{StaticResource StatusBadgeBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
    </Style>

    <Style x:Key="ErrorBadgeStyle" TargetType="Border" BasedOn="{StaticResource StatusBadgeBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
    </Style>

    <Style x:Key="InfoBadgeStyle" TargetType="Border" BasedOn="{StaticResource StatusBadgeBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
    </Style>

    <Style x:Key="UnknownBadgeStyle" TargetType="Border" BasedOn="{StaticResource StatusBadgeBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource TextDisabledBrush}"/>
    </Style>

    <!-- Text style cho badge - luôn trắng để đảm bảo contrast -->
    <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTiny}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>